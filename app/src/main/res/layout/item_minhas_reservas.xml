<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_dialog_minha_conta">

    <!-- Data e horário da reserva -->
    <TextView
        android:id="@+id/txtDataHoraItemReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data e horário"
        android:textColor="#D9B27A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Quantidade de pessoas -->
    <TextView
        android:id="@+id/txtQuantidadeItemReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Quantidade de pessoas"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- Observações da reserva -->
    <TextView
        android:id="@+id/txtObservacoesItemReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Observações"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- Status recebido da API -->
    <TextView
        android:id="@+id/txtStatusItemReserva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Situação: não consultada"
        android:textColor="#D9B27A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Botão exibido somente quando o cancelamento for permitido -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelarReserva"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="CANCELAR RESERVA"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_botao_kiora"
        android:backgroundTint="@null"
        android:visibility="gone" />

</LinearLayout>