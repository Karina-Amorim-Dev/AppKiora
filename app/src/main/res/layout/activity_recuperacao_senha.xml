<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo original do Kiora -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Logo do restaurante -->
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kiora" />

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="RECUPERAR SENHA"
                android:textColor="#D9B27A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Orientação dinâmica -->
            <TextView
                android:id="@+id/txtInstrucaoRecuperacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Informe o e-mail cadastrado para receber um código de recuperação."
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <!-- ETAPA 1: EMAIL -->
            <LinearLayout
                android:id="@+id/layoutEtapaEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edtEmailRecuperacao"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="28dp"
                    android:hint="E-mail cadastrado"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="12dp"
                    android:padding="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:singleLine="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSolicitarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="ENVIAR CÓDIGO"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_kiora"
                    android:backgroundTint="@null" />

            </LinearLayout>

            <!-- ETAPA 2: VALIDAR CÓDIGO -->
            <LinearLayout
                android:id="@+id/layoutEtapaCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtCodigoRecuperacao"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="28dp"
                    android:hint="Código de 6 dígitos"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true"
                    android:gravity="center"
                    android:padding="12dp"
                    android:letterSpacing="0.15"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:textSize="20sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnValidarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="VALIDAR CÓDIGO"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_kiora"
                    android:backgroundTint="@null" />

                <TextView
                    android:id="@+id/txtReenviarCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Solicitar novo código"
                    android:textColor="#D9B27A"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- ETAPA 3: NOVA SENHA -->
            <LinearLayout
                android:id="@+id/layoutEtapaNovaSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtNovaSenhaRecuperacao"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="28dp"
                    android:hint="Nova senha"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:maxLength="128"
                    android:drawableStart="@drawable/ic_senha"
                    android:drawablePadding="12dp"
                    android:padding="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <EditText
                    android:id="@+id/edtConfirmarSenhaRecuperacao"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="14dp"
                    android:hint="Confirmar nova senha"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:maxLength="128"
                    android:drawableStart="@drawable/ic_senha"
                    android:drawablePadding="12dp"
                    android:padding="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRedefinirSenha"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="REDEFINIR SENHA"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_kiora"
                    android:backgroundTint="@null" />

            </LinearLayout>

            <!-- Voltar ao login -->
            <TextView
                android:id="@+id/txtVoltarLoginRecuperacao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="VOLTAR AO LOGIN"
                android:textColor="#D9B27A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>