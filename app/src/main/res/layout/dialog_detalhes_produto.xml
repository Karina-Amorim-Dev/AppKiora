<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_dialog_minha_conta"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Imagem do produto -->
        <ImageView
            android:id="@+id/imgDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagem do produto"
            android:visibility="gone" />

        <!-- Identificação de combo -->
        <TextView
            android:id="@+id/txtComboDetalhesProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="COMBO"
            android:textColor="#D9B27A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Nome -->
        <TextView
            android:id="@+id/txtNomeDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#D9B27A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Categoria -->
        <TextView
            android:id="@+id/txtCategoriaDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <!-- Descrição -->
        <TextView
            android:id="@+id/txtDescricaoDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- Preço original -->
        <TextView
            android:id="@+id/txtPrecoOriginalDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Desconto -->
        <TextView
            android:id="@+id/txtDescontoDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#D9B27A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Preço atual -->
        <TextView
            android:id="@+id/txtPrecoDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D9B27A"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Disponibilidade -->
        <TextView
            android:id="@+id/txtDisponibilidadeDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Botão fechar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFecharDetalhesProduto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="FECHAR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_botao_kiora"
            android:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>