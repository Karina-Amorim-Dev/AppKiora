<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo da tela -->
    <ImageView
        android:id="@+id/imgFundoCadastro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Conteúdo principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Logo Kiora -->
            <ImageView
                android:id="@+id/imgLogoCadastro"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kiora" />

            <!-- Título -->
            <TextView
                android:id="@+id/txtTituloCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="CADASTRO"
                android:textColor="#D9B27A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Campo Nome -->
            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Nome"
                android:inputType="textPersonName"
                android:drawableStart="@drawable/ic_nome"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Campo E-mail -->
            <EditText
                android:id="@+id/edtEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Campo Senha -->
            <EditText
                android:id="@+id/edtSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:drawableStart="@drawable/ic_senha"
                android:drawableEnd="@drawable/ic_mostrar_senha"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Campo Confirmar Senha -->
            <EditText
                android:id="@+id/edtConfirmarSenha"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Confirmar senha"
                android:inputType="textPassword"
                android:drawableStart="@drawable/ic_senha"
                android:drawableEnd="@drawable/ic_mostrar_senha"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

           <!-- Área de aceite dos Termos de Uso e da Política de Privacidade -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Checkbox obrigatório para aceitar os documentos -->
                <CheckBox
                    android:id="@+id/chkAceiteTermos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D9B27A"
                    android:text="Li e aceito os documentos abaixo:"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <!-- Link para os Termos de Uso -->
                <TextView
                    android:id="@+id/txtTermosUso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:padding="4dp"
                    android:text="Termos de Uso"
                    android:textColor="#D9B27A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Link para a Política de Privacidade -->
                <TextView
                    android:id="@+id/txtPoliticaPrivacidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:padding="4dp"
                    android:text="Política de Privacidade"
                    android:textColor="#D9B27A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- Botão para finalizar o cadastro -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="30dp"
                android:text="CADASTRAR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

            <!-- Aviso para usuários que já possuem uma conta -->
            <TextView
                android:id="@+id/txtJaPossuiConta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Já possui uma conta?"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Link para fazer login -->
            <TextView
                android:id="@+id/txtFazerLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="30dp"
                android:text="Fazer login"
                android:textColor="#D9B27A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>