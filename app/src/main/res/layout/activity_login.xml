<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================================= -->
    <!-- FUNDO DA TELA                                             -->
    <!-- Utiliza o mesmo fundo da página principal do Kiora.      -->
    <!-- ========================================================= -->
    <ImageView
        android:id="@+id/imgFundoLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ========================================================= -->
    <!-- ÁREA DE CONTEÚDO                                          -->
    <!-- ========================================================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- ================================================= -->
            <!-- LOGO KIORA                                         -->
            <!-- Mesmo arquivo utilizado na página principal.      -->
            <!-- ================================================= -->
            <ImageView
                android:id="@+id/imgLogoLogin"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kiora" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Bem-vindo!!"
                android:textColor="#D9B27A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Campo E-mail -->
            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Campo Senha -->
            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:drawableStart="@drawable/ic_senha"
                android:drawableEnd="@drawable/ic_mostrar_senha"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <!-- Botão Entrar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEntrarLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="25dp"
                android:text="ENTRAR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

            <!-- Esqueci minha senha -->
            <TextView
                android:id="@+id/txtEsqueciSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Esqueci minha senha"
                android:textColor="#D9B27A"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Texto para cadastro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Ainda não possui uma conta?"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Botão Cadastrar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCadastrarLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:text="CADASTRAR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>