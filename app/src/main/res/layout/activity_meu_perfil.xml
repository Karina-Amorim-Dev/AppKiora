<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo do Kiora -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Conteúdo da tela -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Cabeçalho com ícone de saída -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnSair"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_logout"
                    android:tint="#D9B27A"
                    android:padding="10dp"
                    android:contentDescription="Sair da conta"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <!-- Logo -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kiora" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MEU PERFIL"
                android:textColor="#D9B27A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Nome do usuário -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Nome completo"
                android:textColor="#D9B27A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:text="Carregando..."
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#80D9B27A" />

            <!-- E-mail usado como login -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="E-mail / Login"
                android:textColor="#D9B27A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:text="Carregando..."
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#80D9B27A" />

            <!-- Editar perfil -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:text="EDITAR PERFIL"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

            <!-- Alterar senha -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAlterarSenha"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:text="ALTERAR SENHA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

            <!-- Separador da área de desativação -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="30dp"
                android:background="#80D9B27A" />

            <!-- Aviso de desativação -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Desativar minha conta"
                android:textColor="#D9B27A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Essa ação desativará sua conta e você poderá perder o acesso aos recursos do aplicativo e do site."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Desativar conta -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDesativarConta"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:text="DESATIVAR MINHA CONTA"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

            <!-- Voltar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVoltarPerfil"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:text="VOLTAR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_botao_kiora"
                android:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
