<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_minha_conta">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Minha conta"
        android:textColor="#D9B27A"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Acesse sua conta Kiora"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEntrarConta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="ENTRAR"
        android:textColor="#111111"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_botao_kiora"
        android:backgroundTint="#D9B27A" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCadastrarConta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="CADASTRAR-SE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_botao_kiora"
        android:backgroundTint="@null" />

</LinearLayout>
