<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo com a identidade visual do Kiora -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Conteúdo da tela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Cabeçalho com ícone de saída -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnSair"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logout"
                android:tint="#D9B27A"
                android:padding="10dp"
                android:contentDescription="Sair da conta"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <!-- Logo -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Kiora" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MINHAS RESERVAS"
            android:textColor="#D9B27A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consulte e acompanhe suas reservas."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- Estado da consulta: carregamento, vazio ou erro -->
        <TextView
            android:id="@+id/txtEstadoMinhasReservas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:text="Carregando suas reservas..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:visibility="visible" />

        <!-- Lista de reservas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMinhasReservas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Botão para voltar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoltarMinhasReservas"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_kiora"
            android:backgroundTint="@null"
            android:text="VOLTAR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
