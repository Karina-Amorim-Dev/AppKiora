<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_minha_conta">

    <!-- Título do modal -->
    <TextView
        android:id="@+id/txtTituloAlterarSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alterar senha"
        android:textColor="#D9B27A"
        android:textSize="21sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Campo: senha atual -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senha atual"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#D9B27A"
            android:contentDescription="Cadeado"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/edtSenhaAtual"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Digite sua senha atual"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnMostrarSenhaAtual"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#D9B27A"
            android:contentDescription="Mostrar ou ocultar senha atual"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Sublinhado dourado de largura completa -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9B27A" />

    <!-- Espaçamento entre os campos -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Campo: nova senha -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nova senha"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#D9B27A"
            android:contentDescription="Cadeado"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/edtNovaSenha"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Digite a nova senha"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnMostrarNovaSenha"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#D9B27A"
            android:contentDescription="Mostrar ou ocultar nova senha"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Sublinhado dourado de largura completa -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9B27A" />

    <!-- Espaçamento entre os campos -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Campo: confirmação da nova senha -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar nova senha"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#D9B27A"
            android:contentDescription="Cadeado"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/edtConfirmarNovaSenha"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Repita a nova senha"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnMostrarConfirmarSenha"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#D9B27A"
            android:contentDescription="Mostrar ou ocultar confirmação da senha"
            android:scaleType="centerInside"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Sublinhado dourado de largura completa -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9B27A" />

    <!-- Espaçamento antes dos botões -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Botões de ação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelarAlterarSenha"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="CANCELAR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_botao_kiora"
            android:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarNovaSenha"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="SALVAR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_botao_kiora"
            android:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>
